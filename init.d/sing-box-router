#!/bin/sh /etc/rc.common

START=98
STOP=10
USE_PROCD=1

PROG="/usr/local/bin/sing-box"
CONF_DIR="/etc/sing-box-router"
WORK_DIR="/var/lib/sing-box-router"

wait_network() {
    local i gw dev

    for i in $(seq 1 90); do
        gw="$(ip -4 route show default 2>/dev/null | awk '/default/ { print $3; exit }')"
        dev="$(ip -4 route show default 2>/dev/null | awk '/default/ { for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')"
        if [ -n "$gw" ] && [ -n "$dev" ] && ip -4 addr show "$dev" 2>/dev/null | grep -q ' inet '; then
            break
        fi
        sleep 1
    done

    if [ -n "$gw" ]; then
        for i in $(seq 1 15); do
            ping -c 1 -W 1 "$gw" >/dev/null 2>&1 && return 0
            sleep 1
        done
    fi
}

wait_local_port() {
    local port timeout i

    port="$1"
    timeout="${2:-60}"
    i=0

    while [ "$i" -lt "$timeout" ]; do
        if { ss -lnt 2>/dev/null || netstat -lnt 2>/dev/null || true; } | grep -q "127.0.0.1:$port"; then
            return 0
        fi
        i=$((i + 1))
        sleep 1
    done

    return 1
}

wait_trusttunnel_ready() {
    local i

    for i in $(seq 1 24); do
        if wait_local_port 11080 1; then
            if ! command -v curl >/dev/null 2>&1; then
                return 0
            fi
            if curl -4 -fsS --socks5-hostname 127.0.0.1:11080 \
                --connect-timeout 3 --max-time 4 \
                https://www.gstatic.com/generate_204 \
                -o /dev/null >/dev/null 2>&1; then
                return 0
            fi
        fi
        sleep 1
    done

    return 1
}

start_service() {
    if [ ! -x "$PROG" ]; then
        echo "missing executable: $PROG" >&2
        return 1
    fi
    if [ ! -r "$CONF_DIR/config.json" ]; then
        echo "missing config: $CONF_DIR/config.json" >&2
        return 1
    fi
    mkdir -p "$WORK_DIR"
    wait_network
    wait_trusttunnel_ready || true

    procd_open_instance
    procd_set_param command "$PROG" -D "$WORK_DIR" -C "$CONF_DIR" run
    procd_set_param respawn 3600 10 -1
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
